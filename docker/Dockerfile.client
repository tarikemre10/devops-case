# React build
FROM node@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# nginx runtime
FROM nginx@sha256:b34848eff6db786b6b1282d3a9c3fd0b5563dfb6d261df4923378b419e0d24f0 AS runtime

ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    BACKEND_UPSTREAM=backend:5050

RUN apk upgrade --no-cache

COPY --from=build /app/build /usr/share/nginx/html
COPY --from=nginxconf default.conf.template /etc/nginx/templates/default.conf.template

RUN chown -R nginx:nginx /var/cache/nginx /run /etc/nginx/conf.d /usr/share/nginx/html

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1
