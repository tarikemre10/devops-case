# Express backend
#
# Build context: mern-project/server
#   docker build -f docker/Dockerfile.server -t mern-server mern-project/server
#
# Base image digest ile pinlidir: tag mutable olduğu için aynı commit'in aynı
# imajı ürettiği garantisi yalnızca digest ile sağlanır.

# --- Stage 1: bağımlılıklar -------------------------------------------------
# node:20-alpine
FROM node@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS deps

WORKDIR /app

# Önce yalnızca manifest dosyaları kopyalanır. Kaynak kod değiştiğinde bu katman
# cache'ten gelir ve npm ci tekrar çalışmaz.
COPY package.json package-lock.json ./

RUN npm ci --omit=dev && npm cache clean --force

# --- Stage 2: çalışma zamanı ------------------------------------------------
# node:20-alpine
FROM node@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS runtime

# tini PID 1 olarak çalışır: zombie process'leri toplar ve SIGTERM'i uygulamaya
# doğru iletir. Bu olmadan Kubernetes rolling update sırasında server.mjs'teki
# graceful shutdown tetiklenmez.
#
# apk upgrade: base imaj yayınlandıktan sonra çıkan OS yamalarını alır
# (libssl3/libcrypto3 gibi). Digest pinlemesi tekrarlanabilirliği sağlar,
# bu satır da güvenlik yamalarını.
RUN apk upgrade --no-cache && apk add --no-cache tini

# npm çalışma zamanında kullanılmıyor — uygulama `node server.mjs` ile başlar.
# Base imajda gelen npm, kendi bundled bağımlılıklarıyla (tar, minimatch,
# cross-spawn, sigstore …) saldırı yüzeyine 18 adet HIGH/CRITICAL CVE ekliyordu.
# Çalışma zamanı imajından kaldırılması hem imajı küçültür hem taramayı temizler.
RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/bin/npm \
           /usr/local/bin/npx

ENV NODE_ENV=production \
    PORT=5050 \
    HOST=0.0.0.0

WORKDIR /app

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

# node kullanıcısı (uid 1000) base imajda hazır gelir.
USER node

EXPOSE 5050

# busybox wget alpine'da yerleşiktir; curl kurmaya gerek yok.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5050/healthcheck || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.mjs"]
