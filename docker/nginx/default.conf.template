# Compose ve Kubernetes için ortak şablon; entrypoint envsubst ile render eder.

server {
    listen 8080;
    server_name _;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    root /usr/share/nginx/html;

    # Dinamik DNS çözümlemesi backend başlamadan nginx'in hata vermesini önler.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend_upstream http://${BACKEND_UPSTREAM};

    # Değişkenli proxy_pass öneki kaldırmadığı için /api rewrite edilir.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # Hash'li asset'ler uzun süre cache'lenebilir.
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Yeni deploy'un hemen görünmesi için index.html cache'lenmez.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # Client-side rotalar için SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
