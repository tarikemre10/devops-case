# Bu dosya bir örnektir. Lokal geliştirme için `config.env` olarak kopyalayın.
# Konteyner/Kubernetes ortamında bu değerler env değişkeni olarak verilir,
# dosya kullanılmaz.

# --- MongoDB ---
# Lokal:      mongodb://localhost:27017
# Compose:    mongodb://mongo:27017
# Kubernetes: mongodb://<user>:<pass>@mongodb-0.mongodb:27017/sample_training?authSource=admin
ATLAS_URI=mongodb://localhost:27017

# Bağlanılacak veritabanı adı
MONGO_DB=sample_training

# Bağlantı kurulamazsa kaç kez denenecek (üstel backoff). Tükenirse süreç
# exit(1) ile çıkar ve restart sorumluluğu Kubernetes'e geçer.
MONGO_MAX_RETRIES=10

# --- HTTP sunucu ---
PORT=5050
# Konteynerde 0.0.0.0 olmalı, aksi halde servis dışarıdan erişilemez.
HOST=0.0.0.0

# --- Ortam ---
NODE_ENV=development

# --- CORS ---
# Boş bırakılırsa CORS middleware hiç eklenmez (nginx reverse proxy ile
# same-origin çalışıldığı için varsayılan budur).
# Gerekirse virgülle ayrılmış liste: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Log ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Env dosyası yolu (opsiyonel) ---
# ENV_FILE=./config.env
