# Bu dosyayı `terraform.tfvars` olarak kopyalayın.
# *.tfvars .gitignore'dadır; yalnızca bu örnek commit'lenir.

project     = "mern-devops-case"
environment = "prod"
region      = "eu-central-1"

# --- CI ---
# GitHub Actions OIDC trust policy'si bu repoyla sınırlanır.
github_repository = "tarikemre10/devops-case"

# --- Node grubu ---
# Kota: eu-central-1 vCPU limiti 16. 3 × t3.medium = 6 vCPU.
# Ölçülen: t3.medium başına ~3.37 GiB allocatable bellek, max-pods 17.
# 3 node → ~10.1 GiB / 51 pod slotu; monitoring + uygulama + HPA rahat sığar.
node_instance_type = "t3.medium"
node_desired_size  = 3
node_min_size      = 3
node_max_size      = 4
node_disk_size     = 30

# --- Kubernetes sürümü ---
# Değiştirmeden önce STANDART destekte olduğunu doğrulayın; extended support
# control plane ücretini 6 katına çıkarır ve varsayılan olarak açıktır:
#   aws eks describe-cluster-versions --region eu-central-1 \
#     --query "clusterVersions[?clusterVersion=='1.34'].status"
cluster_version = "1.34"

# --- Ağ ---
# Tek NAT Gateway maliyet tercihidir; o AZ düşerse private egress kesilir.
single_nat_gateway = true

# --- Güvenlik ---
# Sabit IP'li bir ortamda mutlaka daraltın.
cluster_public_access_cidrs = ["0.0.0.0/0"]
