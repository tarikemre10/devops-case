{
  "title": "MERN — Servis Durumu",
  "uid": "mern-services",
  "tags": ["mern", "devops-case"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Hazır backend pod'u",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_ready{namespace=\"mern\",container=\"backend\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Hazır frontend pod'u",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_ready{namespace=\"mern\",container=\"frontend\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "MongoDB hazır",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_ready{namespace=\"mern\",container=\"mongodb\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Son 1 saatteki restart",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"mern\"}[1h])) or vector(0)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend HPA — istenen / mevcut replica",
      "description": "HPA ölçekleme kanıtı (Aşama 4 kabul kriteri).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "mevcut",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"mern\"}"
        },
        {
          "refId": "B",
          "legendFormat": "istenen",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"mern\"}"
        },
        {
          "refId": "C",
          "legendFormat": "max",
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"mern\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU kullanımı (core)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"mern\",container!=\"\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bellek kullanımı",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"mern\",container!=\"\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MongoDB PVC doluluk",
      "description": "MongoDiskFilling alert'i %80 eşiğinde ateşler.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{persistentvolumeclaim}}",
          "expr": "kubelet_volume_stats_used_bytes{namespace=\"mern\"} / kubelet_volume_stats_capacity_bytes{namespace=\"mern\"}"
        }
      ]
    }
  ]
}
